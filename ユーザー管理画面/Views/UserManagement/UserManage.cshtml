    <script type="text/javascript">
        //AI解説を書いておきます
        // --------------------------------------------------
        // 1. 画面を開いた時の初期データ取得（コンボ技）
        // --------------------------------------------------
        $(document).ready(function () {
            $("#cbx表示区分").val("0");

            // ① まず Find で C# に「登録済(2)だよ！」とサーバーの検索条件を更新させる
            $.ajax({
                type: "post",
                url: "/UserManagement/Find",
                data: JSON.stringify({
                    rowCount: 10,
                    pageNum: 1,
                    表示区分: "0"
                }),
                contentType: 'application/json',
                success: function () {
                    // ② Findの更新が終わったら、すかさず GetPage で表のデータを取ってくる！
                    $.ajax({
                        type: "post",
                        url: "/UserManagement/GetPage",
                        data: JSON.stringify({
                            rowCount: 10,
                            pageNum: 1
                        }),
                        contentType: 'application/json',
                        success: function (pageData) {
                            // 最終的な画面の更新は GetPage の結果を使う
                            $("#divユーザーの一覧").html(pageData);

                            if ($("#検索結果").length > 0) {
                                $("#divユーザーの一覧").height($("#検索結果").height());
                            }
                        }
                    });
                },
                error: function (xhr) {
                    console.log("Find(初期)エラー: " + xhr.responseText);
                }
            });
        });

        // --------------------------------------------------
        // 2. 表示区分が変更されたときの処理（コンボ技）
        // --------------------------------------------------
        $(document).on('change', '#cbx表示区分', function (event) {
            event.preventDefault();

            var selectedKbn = $(this).val(); // 選ばれた表示区分
            var rowCount = $("#cbx表示件数").val() || 10;

            // ① まず Find で新しい検索条件をサーバーに伝える
            $.ajax({
                type: "post",
                url: "/UserManagement/Find",
                data: JSON.stringify({
                    rowCount: rowCount,
                    pageNum: 1,
                    表示区分: selectedKbn
                }),
                contentType: 'application/json',
                success: function () {
                    // ② 伝え終わったら、すかさず GetPage で新しい表をもらう！
                    $.ajax({
                        type: "post",
                        url: "/UserManagement/GetPage",
                        data: JSON.stringify({
                            rowCount: rowCount,
                            pageNum: 1
                        }),
                        contentType: 'application/json',
                        success: function (pageData) {
                            $("#divユーザーの一覧").html(pageData);

                            if ($("#検索結果").length > 0) {
                                $("#divユーザーの一覧").height($("#検索結果").height());
                            }
                        }
                    });
                },
                error: function (xhr) {
                    console.log("Find(変更時)エラー: " + xhr.responseText);
                }
            });
        });

        // --------------------------------------------------
        // 3. 以下の処理（表示件数、ページネーション、ボタン類、ソート）は既存のまま
        // --------------------------------------------------

        $(document).on('change', "[id ='cbx表示件数']", function (event) { // event追加
            event.preventDefault();
            // ShowLoading();
            $.ajax({
                type: "post",
                url: "/UserManagement/GetPage",
                data: JSON.stringify({
                    rowCount: $("#cbx表示件数").val(),
                    pageNum: 1,
                    表示区分: $("#cbx表示区分").val()
                }),
                contentType: 'application/json',
                success: function (data) {
                    // HideLoading();
                    $("#divユーザーの一覧").html(data);
                    $("#divユーザーの一覧").height($("#検索結果").height());
                },
                error: function (xhr, status, error) {
                    // HideLoading();
                    // ShowErrMsg(xhr.responseText);
                }
            });
        });

        $(document).on('change', "[id^='cbx現ページ']", function (event) { // event追加
            event.preventDefault();
            // ShowLoading();
            if ($('#lbl総件数').text() == "0") {
                return;
            }

            $.ajax({
                type: "post",
                url: "/UserManagement/GetPage",
                data: JSON.stringify({
                    rowCount: $("#cbx表示件数").val(),
                    pageNum: $("#cbx現ページ").val()
                }),
                contentType: 'application/json',
                success: function (data) {
                    // HideLoading();
                    $("#divユーザーの一覧").html(data);
                    $("#divユーザーの一覧").height($("#検索結果").height());
                },
                error: function (xhr, status, error) {
                    // HideLoading();
                    // ShowErrMsg(xhr.responseText);
                }
            });
        });

        $(document).on('click', "[id ='btn前ページ']", function (event) { // event追加
            event.preventDefault();
            var selecting = $('#cbx現ページ').val();

            if (selecting == 1) {
                return;
            }

            $('#cbx現ページ').val(Number(selecting) - 1);
            $('#btn次ページ').attr("src", "/Images/right_triangle.png");
            // ShowLoading();
            $.ajax({
                type: "post",
                url: "/UserManagement/GetPage",
                data: JSON.stringify({
                    rowCount: $("#cbx表示件数").val(),
                    pageNum: (Number(selecting) - 1)
                }),
                contentType: 'application/json',
                success: function (data) {
                    // HideLoading();
                    $("#divユーザーの一覧").html(data);
                    $("#divユーザーの一覧").height($("#検索結果").height());
                },
                error: function (xhr, status, error) {
                    // HideLoading();
                    // ShowErrMsg(xhr.responseText);
                }
            });
        });

        $(document).on('click', "[id ='btn次ページ']", function (event) { // event追加
            event.preventDefault();

            var maxvalue = $('#cbx現ページ option:last-child').val();
            var selecting = $('#cbx現ページ').val();

            if (selecting == maxvalue) {
                return;
            }

            $('#cbx現ページ').val(Number(selecting) + 1);
            $('#btn前ページ').attr("src", "/Images/left_triangle.png");
            // ShowLoading();
            $.ajax({
                type: "post",
                url: "/UserManagement/GetPage",
                data: JSON.stringify({
                    rowCount: $("#cbx表示件数").val(),
                    pageNum: (Number(selecting) + 1)
                }),
                contentType: 'application/json',
                success: function (data) {
                    // HideLoading();
                    $("#divユーザーの一覧").html(data);
                    $("#divユーザーの一覧").height($("#検索結果").height());
                },
                error: function (xhr, status, error) {
                    // HideLoading();
                    // ShowErrMsg(xhr.responseText);
                }
            });
        });

        $(document).on('click', "[id='btn削除']", function () {
            var checked = false;
            var havedata = $('input[id^="chkユーザー選択"]').length;
            $('input[id^="chkユーザー選択"]:checked').each(function (index, elem) {
                checked = true;
                return false;
            });

            if (checked) {
                $("#lblエラー").html("");
                let result = window.confirm("本当に削除しますか。");

                if (result) {
                    $.ajax({
                        url: "/UserManagement/Delete_User",
                        type: "post",
                        data: $("#Form1").serialize(),
                        success: function (data) {
                            $("#divユーザーの一覧").html(data);
                            $("#divユーザーの一覧").height($("#検索結果").height());
                        },
                        error: function () {
                            alert("システムエラーが発生しました");
                        }
                    });
                }
            } else {
                if (havedata > 0) {
                    $("#lblエラー").html("ユーザーを選択してください");
                }
            }
        });

        $(document).on('click', "[id='btn回復']", function () {
            $("#lblエラー").html("");
            var checked = false;
            var havedata = $('input[id^="chkユーザー選択"]').length;
            $('input[id^="chkユーザー選択"]:checked').each(function (index, elem) {
                checked = true;
                return false;
            });

            if (checked) {
